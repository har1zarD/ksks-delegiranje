# ── Supabase (Project Settings → API) ──
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Samo na serveru: kreiranje korisnika, MCP, email log, cron. Nikad u browser.
SUPABASE_SECRET_KEY=

# ── Gmail SMTP ──
# App šifra: Google nalog → Sigurnost → potvrda u 2 koraka → App passwords (16 slova)
GMAIL_USER=ksksdelegiranje@gmail.com
GMAIL_APP_PASSWORD=

EMAIL_FROM=
# Test način: email ide samo na ove adrese (zarezom odvojene); prazno = svima
EMAIL_ONLY_TO=

# ── Aplikacija ──
# Javna adresa (linkovi u emailovima i MCP). Lokalno http://localhost:4873, na Vercelu https://<projekat>.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:4873

# Početna šifra za nove naloge (korisnik je mijenja u Postavkama nakon prve prijave)
INITIAL_PASSWORD=

# ── Email preko SMTP servisa umjesto Gmaila (npr. Brevo: smtp-relay.brevo.com, port 587) ──
# Ako je SMTP_HOST postavljen, Gmail se ne koristi. EMAIL_FROM = verifikovani pošiljalac kod tog servisa.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
